# ─────────────────────────────────────────────────────────────────
# Calori App — Environment Variables Example
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=calori
POSTGRES_USER=calori
POSTGRES_PASSWORD=calori_secret_2026

# ── USDA FoodData Central (free API key) ────────────────────────
# Get your free key at: https://fdc.nal.usda.gov/api-key-signup.html
# The DEMO_KEY works but has rate limits (30 requests/hour, 50/day)
USDA_API_KEY=DEMO_KEY

# ── JWT Secret (required) ───────────────────────────────────────
# Signs login tokens. Generate your own; the backend refuses to start without it:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ── First admin account (only used when no admin exists yet) ────
# The admin must change this password on first login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
